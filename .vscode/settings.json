{
  "files.exclude": {
    "**/.codegraph": true,
    "**/.wrangler": true,
    "**/dist": true,
    "**/node_modules": true
  },
  "search.exclude": {
    "**/.codegraph/**": true,
    "**/.wrangler/**": true,
    "**/dist/**": true,
    "**/node_modules/**": true,
    "**/*.gif": true,
    "**/*.jpeg": true,
    "**/*.jpg": true,
    "**/*.mp3": true,
    "**/*.ogg": true,
    "**/*.pdf": true,
    "**/*.png": true,
    "**/*.ttf": true,
    "**/*.wav": true,
    "**/*.webp": true,
    "**/*.woff": true,
    "**/*.woff2": true
  },
  "files.watcherExclude": {
    "**/.codegraph/**": true,
    "**/.wrangler/**": true,
    "**/dist/**": true,
    "**/node_modules/**": true
  },
  "search.useIgnoreFiles": true,
  "search.useGlobalIgnoreFiles": true
}
